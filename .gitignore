# ===== Android / Gradle build outputs =====
build/
app/build/
**/build/
out/
bin/
gen/
captures/
.gradle/
local.properties

# Compiled artifacts - never upload
*.apk
# 样本 APK 放在仓库根目录 apks/，允许提交。其他位置的构建产物仍然忽略。
!/apks/*.apk
*.ap_
*.aab
*.dex
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
*.so
*.o
*.a
*.exe
*.dll

# Signed / release outputs
*.jks
*.keystore
*.pem
*.p12

