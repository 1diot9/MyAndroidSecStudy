<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LabBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/lab_text</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="LabSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lab_text</item>
    </style>

    <style name="LabButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="LabButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="LabResult">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@color/lab_result_bg</item>
        <item name="android:padding">12dp</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/lab_text</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>
